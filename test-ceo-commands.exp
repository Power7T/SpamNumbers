#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -t -o StrictHostKeyChecking=no $user@$host

expect "*password:*"
send "$password\r"

expect "*#*"

# Make sure agent reads the new instructions
send "rm -rf /root/.openclaw/agents/main/sessions/*\r"
expect "*#*"
send "systemctl --user restart openclaw-gateway.service\r"
expect "*#*"
sleep 15

# Enter TUI
send "openclaw tui\r"
sleep 20

# Test 1: "spam" menu trigger
send_user "\n(ACTION: Testing the 'spam' keyword trigger...)\n"
send "spam\r"
sleep 45

send "\x03"
expect "*#*"
send "exit\r"
expect eof
