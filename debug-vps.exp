#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. Inspect the service
send "systemctl --user cat openclaw-gateway.service\r"
expect "root@*#"

# 2. Check the OpenClaw configuration
send "openclaw config list\r"
expect "root@*#"

# 3. VERIFY BETTER-SQLITE3 CAN BE LOADED IN THE SKILL DIR
send "cd /root/.openclaw/workspace/skills/spam-numbers/scripts\r"
expect "root@*#"
send "node -e 'console.log(require(\"better-sqlite3\").version)'\r"
expect {
    "node_modules" { send_user "REQUIRE FAILED\n" }
    "root@*#" { send_user "REQUIRE SUCCESS\n" }
}

# 4. START TUI AND SHOW THE WORKING DIRECTORY
send "openclaw tui\r"
sleep 15
send "print your current working directory\r"
sleep 15
send "\x03"
expect "root@*#"

send "exit\r"
expect eof
