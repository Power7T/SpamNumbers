#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. Force a clean rebuild of better-sqlite3 in the scripts folder
send "cd ~/SpamNumbers/scripts && rm -rf node_modules/better-sqlite3 && npm install --build-from-source better-sqlite3\r"
expect "root@*#"

# 2. Check if the .node file was actually created
send "ls -l node_modules/better-sqlite3/build/Release/better_sqlite3.node\r"
expect "root@*#"

# 3. Try to require it directly with a small script
send "node -e 'require(\"better-sqlite3\")'\r"
expect {
    "root@*#" { send_user "Requirement SUCCESS\n" }
    "Error" { send_user "Requirement FAILED\n" }
}

# 4. Try stats again from the root proxy
send "cd ~/SpamNumbers && node index.js stats\r"
expect "root@*#"

send "exit\r"
expect eof
