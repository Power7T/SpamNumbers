#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. KILL everything related to OpenClaw
send "pkill -9 -f openclaw\r"
expect "root@*#"

# 2. Re-pull and Re-build the module IN THE WORKSPACE
set skill_path "/root/.openclaw/workspace/skills/spam-numbers/scripts"
send "cd $skill_path && rm -rf node_modules package-lock.json\r"
expect "root@*#"

# 3. Perform a clean build with native compilation
send "npm install --build-from-source\r"
expect "root@*#"

# 4. Check if we have the .node file
send "ls -l node_modules/better-sqlite3/build/Release/better_sqlite3.node\r"
expect "root@*#"

# 5. Start OpenClaw Gateway afresh
send "openclaw gateway &\r"
sleep 10
expect "root@*#"

# 6. Start the TUI
send "openclaw tui --session fixed-final-v2\r"
sleep 20

# 7. Ask the Question
send "Total numbers in database?\r"

set timeout 180
expect {
    "Total spam numbers:" { send_user "TUI CHAT RESPONSE SUCCESS: Fixed at last!\n" }
    "entries" { send_user "TUI CHAT RESPONSE SUCCESS: Response received!\n" }
}

send "\x03"
expect "root@*#"
send "exit\r"
expect eof
