#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -t -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# Reset session history
send "echo '{}' > /root/.openclaw/agents/main/sessions/sessions.json\r"
expect "root@*#"
send "systemctl --user restart openclaw-gateway.service\r"
expect "root@*#"
sleep 15

# Start TUI
send "openclaw tui\r"
sleep 20

# 1. STATS
send_user "\n(TESTING STATS)\n"
send "show spam numbers stats\r"
set timeout 60
expect {
    "Total spam numbers:" { send_user "\n(STATS SUCCESS)\n" }
    "spam numbers" { send_user "\n(STATS SUCCESS PHRASE)\n" }
}
sleep 20

# 2. LOOKUP
send_user "\n(TESTING LOOKUP)\n"
send "is 8005550199 a spam number?\r"
set timeout 60
expect {
    "Not found" { send_user "\n(LOOKUP SUCCESS)\n" }
    "database" { send_user "\n(LOOKUP SUCCESS DB)\n" }
}
sleep 20

# 3. EXPORT
send_user "\n(TESTING EXPORT)\n"
send "export database to csv\r"
set timeout 60
expect {
    "CSV exported" { send_user "\n(EXPORT SUCCESS)\n" }
}
sleep 20

# 4. SCRAPE
send_user "\n(TESTING SCRAPE)\n"
send "run the spam numbers scraper and skip all api keys\r"
set timeout 120
expect {
    "NumVerify" { send "skip\r" }
    "skip" { }
}
sleep 20

# EXIT
send "\x03"
expect "root@*#"
send "exit\r"
expect eof
