#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. FIND THE TUI SCRIPT
send "find /root -path \"*openclaw*tui*index.js\" | head -n 1\r"
expect {
    "/root/openclaw/tui/index.js" { set tui "/root/openclaw/tui/index.js" }
    "/root/.openclaw/tui/index.js" { set tui "/root/.openclaw/tui/index.js" }
    "root@*#" { set tui "node /root/openclaw/tui/index.js" }
}

# 2. START THE TUI WITH NODE
send "node $tui --session test-session\r"

# 3. TYPE THE CHAT REQUEST (We'll wait for any prompt)
expect {
    ">" { 
        send "how many spam numbers are in the database?\r"
    }
    ":" { 
        send "how many spam numbers are in the database?\r"
    }
}

# 4. CAPTURE THE RESPONSE
set timeout 120
expect {
    "Total spam numbers:" { send_user "TUI CHAT RESPONSE SUCCESS\n" }
    "entries" { send_user "TUI CHAT RESPONSE SUCCESS (ENTRIES)\n" }
}

# 5. TEST ANOTHER
send "check if 1-800-555-1234 is spam\r"
expect {
    "Not found" { send_user "TUI LOOKUP SUCCESS\n" }
    "flagged" { send_user "TUI LOOKUP SUCCESS (FLAGGED)\n" }
}

send "\x03"
expect "root@*#"
send "exit\r"
expect eof
