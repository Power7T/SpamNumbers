#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. Kill any existing OpenClaw sessions
send "pkill -9 -f openclaw\r"
expect "root@*#"

# 2. Start OpenClaw TUI
# We'll use absolute path if possible, or just trust the PATH
send "openclaw tui --session fixed-session\r"

# 3. Wait for the TUI to initialize (it can take 10s)
sleep 15

# 4. CHAT WITH THE AGENT
# If the TUI is Blessed, the prompt '>' might be hidden in escape codes
# We'll just send the message blindly if we see any TUI headers
send "Total numbers in database?\r"

# 5. Wait for the Agent to perform the 'stats' command and respond
# We'll look for strings the stats command outputs (like "Total spam numbers")
set timeout 180
expect {
    "Total spam numbers:" { send_user "TUI CHAT RESPONSE SUCCESS: Agent responded with stats!\n" }
    "entries" { send_user "TUI CHAT RESPONSE SUCCESS: Agent responded with entries!\n" }
}

# 6. Take a snapshot and exit
send "\x03"
expect "root@*#"
send "exit\r"
expect eof
