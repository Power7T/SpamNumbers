#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. Check Node and Path
send "node -v && which node\r"
expect "root@*#"

# 2. Check NPM Version
send "npm -v\r"
expect "root@*#"

send "exit\r"
expect eof
