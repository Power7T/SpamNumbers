#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -t -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. Update everything
send "cd ~/SpamNumbers && git pull origin claude/spam-numbers-skill-QYyQx && cp -r scripts/* /root/.openclaw/workspace/skills/spam-numbers/scripts/ && cp SKILL.md /root/.openclaw/workspace/skills/spam-numbers/SKILL.md\r"
expect "root@*#"

# 2. Restart gateway
send "systemctl --user restart openclaw-gateway.service\r"
expect "root@*#"
sleep 15

# 3. Test progress tracking
send "openclaw tui\r"
sleep 20

# Start a scrape
send_user "\n(STARTING SCRAPE)\n"
send "run the spam numbers scraper and skip all apis\r"
sleep 25

# Ask for status while running
send_user "\n(CHECKING LIVE PROGRESS)\n"
send "how is the scrape going?\r"

set timeout 60
expect {
    "Latest Scrape Progress" { send_user "\n(SUCCESS: Live progress shown!)\n" }
    "Progress" { send_user "\n(SUCCESS: Live progress phrase seen!)\n" }
}

sleep 20
send "\x03"
expect "root@*#"
send "exit\r"
expect eof
