#!/usr/bin/expect -f
set password "CprT0IzeY4Ww2PgeMII9S"
set host "85.208.51.22"
set user "root"

set timeout 300
spawn ssh -o StrictHostKeyChecking=no $user@$host

expect "password:"
send "$password\r"

expect "root@*#"

# 1. CHECK NODE VERSION
send "node -v\r"
expect "root@*#"

# 2. CHECK THE SKILL REGISTRATION Path
send "cat ~/.openclaw/workspace/skills/spam-numbers/SKILL.md\r"
expect "root@*#"

# 3. VERIFY BETTER-SQLITE3 IN COMMAND LINE
send "cd ~/.openclaw/workspace/skills/spam-numbers && node index.js stats\r"
expect "root@*#"

# 4. IF IT FAILS, FIX IT RIGHT HERE
send "cd scripts && rm -rf node_modules/better-sqlite3 && npm install --build-from-source better-sqlite3\r"
expect "root@*#"

send "exit\r"
expect eof
